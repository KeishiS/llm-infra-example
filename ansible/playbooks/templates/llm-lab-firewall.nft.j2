destroy table inet llm_lab_firewall

table inet llm_lab_firewall {
    set trusted_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ firewall_trusted_ipv4_cidrs | join(', ') }} }
    }

    chain input {
        type filter hook input priority -10; policy drop;

        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto { icmp, ipv6-icmp } accept
        udp sport 67 udp dport 68 accept
        udp sport 547 udp dport 546 accept

        ip saddr @trusted_ipv4 tcp dport 22 accept

        {% if inventory_hostname in groups['webui_server'] %}
            ip saddr @trusted_ipv4 tcp dport { 8080, 8081 } accept
        {% endif %}

        {% if inventory_hostname in groups['ldap_server'] %}
            ip saddr @trusted_ipv4 tcp dport 636 accept
        {% endif %}
        counter reject with icmpx type port-unreachable
    }

    # Podmanの公開ポートはDNAT後の転送経路でも制御
    chain forward {
        type filter hook forward priority -10; policy accept;
        {% if inventory_hostname in groups['ldap_server'] %}
            ct state invalid drop
            ct state established,related accept
            ip daddr {{ ldap_container_subnet }} ct status dnat ip saddr @trusted_ipv4 tcp dport 636 accept
            ip daddr {{ ldap_container_subnet }} drop
        {% endif %}
    }
}

HOST=127.0.0.1
PORT=3000
WEBUI_URL=http://{{ webui_address }}:8080
WEBUI_SECRET_KEY={{ webui_secret_key }}
WEBUI_AUTH=true
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_AUTH=true
ENABLE_PASSWORD_CHANGE_FORM=false
ENABLE_SIGNUP=false
ENABLE_INITIAL_ADMIN_SIGNUP=false
ENABLE_OAUTH_SIGNUP=false
DEFAULT_USER_ROLE=user
WEBUI_ADMIN_EMAIL={{ webui_admin_email }}
# 初回管理者作成のためだけの値です。ローカル認証APIはCaddyで拒否します。
WEBUI_ADMIN_PASSWORD={{ (webui_secret_key ~ ':initial-admin') | hash('sha256') }}
# LDAP認証にはENABLE_PASSWORD_AUTHが必要です。ローカル認証APIはCaddyで拒否します。
ENABLE_LDAP=true
LDAP_SERVER_LABEL=LLM Lab
LDAP_SERVER_HOST={{ ldap_address }}
LDAP_SERVER_PORT=636
LDAP_USE_TLS=true
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT_FILE=/etc/ssl/llm-lab/ldap-ca.crt
LDAP_APP_DN={{ ldap_bind_dn }}
# Podmanのenv-fileは引用符やエスケープを展開しないため、検証済みの値をそのまま渡します。
LDAP_APP_PASSWORD={{ ldap_bind_password }}
LDAP_SEARCH_BASE={{ ldap_people_dn }}
LDAP_SEARCH_FILTER=(objectClass=posixAccount)
LDAP_ATTRIBUTE_FOR_USERNAME=uid
LDAP_ATTRIBUTE_FOR_MAIL=mail
ENABLE_LDAP_GROUP_MANAGEMENT=false
ENABLE_LDAP_GROUP_CREATION=false
JWT_EXPIRES_IN=1h
WEBUI_AUTH_COOKIE_SECURE=false
WEBUI_SESSION_COOKIE_SECURE=false
ENABLE_API_KEYS=true
USER_PERMISSIONS_FEATURES_API_KEYS=true
ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=true
API_KEYS_ALLOWED_ENDPOINTS=/api/models,/api/chat/completions
UVICORN_WORKERS=1
# 接続設定を含む環境変数を優先します。ユーザー・会話履歴は保持します。
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=http://127.0.0.1:{{ llm_tunnel_port }}/v1
OPENAI_API_KEYS=
# アンロード後のモデル読み込みを待てるようにします。
AIOHTTP_CLIENT_TIMEOUT={{ llm_startup_seconds | int + 60 }}
# この構成では使わない機能です。
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
ENABLE_IMAGE_EDIT=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_VERSION_UPDATE_CHECK=false
# 文書検索用のローカルモデルも、この段階では読み込みません。
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
# 一般ユーザーの既定権限も無効にします（管理者は権限制限の対象外）。
USER_PERMISSIONS_FEATURES_WEB_SEARCH=false
USER_PERMISSIONS_FEATURES_IMAGE_GENERATION=false
USER_PERMISSIONS_FEATURES_CODE_INTERPRETER=false
USER_PERMISSIONS_FEATURES_CALENDAR=false
USER_PERMISSIONS_FEATURES_AUTOMATIONS=false
USER_PERMISSIONS_CHAT_FILE_UPLOAD=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=false
ENABLE_DIRECT_CONNECTIONS=false

{
    admin off
    auto_https off
}

http://:8080 {
    @local_auth path /api/v1/auths/signin /api/v1/auths/signin/* /api/v1/auths/signup /api/v1/auths/signup/*
    respond @local_auth "Forbidden" 403
    reverse_proxy 127.0.0.1:3000 {
        flush_interval -1
    }
}

http://:8081 {
    @models {
        method GET
        path /v1/models
    }
    handle @models {
        rewrite * /api/models
        reverse_proxy 127.0.0.1:3000
    }
    @completions {
        method POST
        path /v1/chat/completions
    }
    handle @completions {
        rewrite * /api/chat/completions
        reverse_proxy 127.0.0.1:3000 {
            flush_interval -1
        }
    }
    handle {
        respond "Not found" 404
    }
}
